DB_PATH=./data/signseal.db
# Tamper demo (DEMO ONLY). Must equal exactly "true" to enable.
# Only works when NODE_ENV is not production, so never under `next start` or Docker.
# To enable: copy this file to .env.local and set it to true, or run `npm run dev:demo`.
# `npm run seed` always adds a pre-tampered "Legacy Audit (tampered)" project that shows Broken in any mode.
ENABLE_TAMPER_DEMO=false
