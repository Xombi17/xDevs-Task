DB_PATH=./data/signseal.db
# Tamper demo (DEMO ONLY). Must equal exactly "true" to enable.
# Only works when NODE_ENV is not production, so never under `next start` or Docker.
# To enable: copy this file to .env.local and set it to true, or run `npm run dev:demo`.
# `npm run seed` always adds a pre-tampered "Legacy Audit (tampered)" project that shows Broken in any mode.
ENABLE_TAMPER_DEMO=false

# Optional rate limit for POST /api/review/:token/decision (defaults: 20 requests per 60000 ms per token).
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=60000

# Docker: docker-compose.yml sets its own env (NODE_ENV=production, DB_PATH=/app/data/signseal.db,
# ENABLE_TAMPER_DEMO=false) and keeps the SQLite file in the signseal-data volume.
# The compose "demo" profile (port 3001) runs `npm run dev:demo` and is DEMO ONLY.
# PORT is set by the image (3000); compose maps host 3000 -> app and host 3001 -> demo.
